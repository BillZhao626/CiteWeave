# Run experiments/bootstrap.py to create local random credentials; never commit .env.
CW_DB_PASSWORD=replace-with-generated-personal-password
CW_ADMIN_TOKEN=replace-with-generated-personal-token-at-least-24-characters
# Set DEEPSEEK_API_KEY in your terminal environment. Never add it to frontend variables.
# DEEPSEEK_API_KEY=replace-with-your-own-provider-key
# Optional local settings (defaults match deploy/compose.*.yml):
CW_MONTHLY_BUDGET_YUAN=50
CW_DEEPSEEK_MODEL=deepseek-flash
CW_QUERY_DEADLINE_SECONDS=60
# Target provider-phases-v1 disables internal retries; this is the legacy setting.
CW_PROVIDER_ATTEMPTS=2
CW_MODEL_ATTEMPTS=2
CW_RETRY_BACKOFF_SECONDS=0.5
CW_BREAKER_THRESHOLD=3
CW_BREAKER_COOLDOWN_SECONDS=20
# Host-only overrides (Compose uses explicit container paths / host.docker.internal):
# CW_BLOB_ROOT=.runtime/blobs
# CW_MODEL_URL=http://127.0.0.1:18081
# Fault injection is OFF in normal operation.
CW_ENABLE_FAULTS=false

# Capacity remains 1 until the later concurrency gate.
CW_MAX_ACTIVE_QUERIES=1
CW_INGESTION_DEADLINE_SECONDS=900
# Optional prompt used in the product screenshots; legacy default remains unchanged.
# CW_TELECOM_ANSWER_PROMPT=answer-telecom-consistency-v1
