  "required": [
    "id",
    "scope",
    "block_id",
    "source_sha256",
    "canonical_text_sha256",
    "normalizer_revision",
    "start_offset",
    "end_offset",
    "quote",
    "quote_sha256",
    "locator_kind",
    "boxes"
