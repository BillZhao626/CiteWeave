        "row_index": {
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "column_index": {
          "minimum": 0,
          "title": "Column Index",
          "type": "integer"
        },
        "row_header": {
          "minLength": 1,
          "title": "Row Header",
          "type": "string"
        },
        "column_header": {
          "minLength": 1,
          "title": "Column Header",
          "type": "string"
        }
