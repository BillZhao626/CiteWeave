    },
    "block_id": {
      "title": "Block Id",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "canonical_text_sha256": {
      "title": "Canonical Text Sha256",
      "type": "string"
    },
    "normalizer_revision": {
      "title": "Normalizer Revision",
      "type": "string"
    },
    "start_offset": {
      "minimum": 0,
      "title": "Start Offset",
      "type": "integer"
    },
    "end_offset": {
      "exclusiveMinimum": 0,
      "title": "End Offset",
      "type": "integer"
    },
    "quote": {
      "minLength": 1,
      "title": "Quote",
      "type": "string"
    },
    "quote_sha256": {
      "title": "Quote Sha256",
      "type": "string"
    },
    "locator_kind": {
      "enum": [
        "paragraph",
        "pdf_bbox",
        "table_cells"
      ],
      "title": "Locator Kind",
      "type": "string"
