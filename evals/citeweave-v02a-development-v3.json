  "sources": [
    {
      "canonical_sha256": "b7c30e42b6a5ec222b6a872b98b7832012d216a8bdd5711b672875c3e80e4b6a",
      "document_id": "8a550b02-93f4-57ee-88d5-265e3e21ab96",
      "family": "D1",
      "id": "D1.manual",
      "pdf_box": [
        0.0784313725490196,
        0.07575757575757576,
        0.9281045751633987,
        0.11868686868686869
      ],
      "pdf_sha256": "887494ebc37ace42ce3b7512ded394dee5bf82c16512900630d6e8a8ed0b2867",
      "provenance": "original_AI_assisted_MIT_review_pending",
      "text": "Ferrule-Q requires a nine-minute cooldown before optical inspection. Thermal\nTray-R uses a separate four-minute standby cycle.",
      "version_id": "8077f914-b388-5a27-afdb-699735635d6b"
    },
    {
      "canonical_sha256": "afe250226584df0dc74da30bfcd73d16736dab901e7017a1e41a46bfe71d4d01",
      "document_id": "6118a01a-7b69-55da-b98c-e2a35e2d1cb5",
      "family": "D2",
      "id": "D2.manual",
      "pdf_box": [
        0.0784313725490196,
        0.07575757575757576,
        0.9281045751633987,
        0.11868686868686869
      ],
      "pdf_sha256": "e88c3735cfc7e4db1eeea837adf7779c209ca0b7cbb517156a2fc24d20eed9d2",
      "provenance": "original_AI_assisted_MIT_review_pending",
      "text": "Grove-Panel records an alarm by illuminating its amber indicator. Orchard-Clock\ncalibration uses a violet status marker and does not govern Grove-Panel alarms.",
      "version_id": "96589c61-798e-574c-9fba-c04d17bdfc8a"
    },
    {
      "canonical_sha256": "70ab8e4c5db954e10cabb759999f8a1bafc2fb7cbab5fed82413aaa97d898ea6",
      "document_id": "a1ff4504-79bc-511c-8089-a03088b54370",
      "family": "D3",
      "id": "D3.manual",
      "pdf_box": [
        0.0784313725490196,
        0.07575757575757576,
        0.9281045751633987,
        0.1414141414141414
      ],
      "pdf_sha256": "921f0de2fb8c5c7a48e30e6821728fe4f88ee398ae3bc1a75e10a6faa22f56ab",
      "provenance": "original_AI_assisted_MIT_review_pending",
      "text": "Cobalt-Latch release amber uses a three-notch alignment. Cobalt-Latch release\nviolet uses a five-notch alignment. Display framing does not change latch\nalignment.",
      "version_id": "39c513f3-4a62-5236-8efd-d15dab4e1787"
    },
    {
      "canonical_sha256": "6ef961e63c75ddfd6ae61ca2abd0ce20d30c588fece1f383113d42827740628c",
      "document_id": "197979b8-5674-5e05-9304-87176861f18d",
      "family": "D4",
      "id": "D4.manual",
      "pdf_box": [
        0.0784313725490196,
        0.07575757575757576,
        0.9281045751633987,
        0.11868686868686869
      ],
      "pdf_sha256": "fcd81e986c6deab76772abf7f066d3ef25432a3eb59551cd5fbf228d432b091c",
      "provenance": "original_AI_assisted_MIT_review_pending",
      "text": "Beacon-North displays a blue indicator after a valve test. Beacon-South displays\na green indicator after a valve test. Neither unit is a default selection.",
      "version_id": "1506a478-7da5-51d3-8e26-f71599e4550f"
    },
    {
      "canonical_sha256": "43f7bdae874f08f0223aea8c7807d55b447c790d096dee9652ef484f12e1cfcb",
      "document_id": "65650e4d-fcaa-5640-94ea-28ae818e6e42",
      "family": "D5",
      "id": "D5.manual",
      "pdf_box": [
        0.0784313725490196,
        0.07575757575757576,
        0.9281045751633987,
        0.11868686868686869
      ],
      "pdf_sha256": "e38d9026e7065e3b17d7494ad63eb3ddd6240770264bbbf835255c25ec87e492",
      "provenance": "original_AI_assisted_MIT_review_pending",
      "text": "Quill m4 must not relay before 24 hours have elapsed after initialization. At or\nafter 24 hours, Quill m4 may relay if its isolation check passes.",
      "version_id": "1cf8706f-2078-579a-907c-84e6e6b5fc6d"
    },
    {
      "canonical_sha256": "7e5323652f6d426b3f762ef2d02fe5f9633f3b807fbe3bfd93056999eb9bb5fc",
      "document_id": "1b4d4e77-f64b-5b75-ae74-66ded16a5c6d",
      "family": "D6",
      "id": "D6.ledger",
      "pdf_box": [
        0.0784313725490196,
        0.07575757575757576,
        0.9281045751633987,
        0.11868686868686869
      ],
      "pdf_sha256": "55160ef8d32f9d4643c50a2a451c4682d73027de8f9645947e75ee51b172ba0c",
      "provenance": "original_AI_assisted_MIT_review_pending",
      "text": "Sable-Pump maintenance ledgers record scheduled service dates and cycle counts.\nThis ledger defines no brownout contingency.",
      "version_id": "f1d40561-6c03-5d72-80f3-05413942d7d0"
    },
    {
      "canonical_sha256": "1627a0ff2d4c9db5ea0c628c3fc2b1ad125c43d9a90c252709b4997d502c2663",
      "document_id": "7af30a2c-7d79-5e21-aa9b-017f21350fc6",
      "family": "D6",
      "id": "D6.contingency",
      "pdf_box": [
        0.0784313725490196,
        0.07575757575757576,
        0.9281045751633987,
        0.11868686868686869
      ],
      "pdf_sha256": "a31c86c83f2284653180dd09101ad56c9a298dbe98e72b6c00ca1393fa8c890b",
      "provenance": "original_AI_assisted_MIT_review_pending",
      "text": "During a brownout, Sable-Pump must switch to the gravity bypass. Scheduled\nservice records do not define or replace this contingency.",
      "version_id": "84f2de55-f6f4-5ddf-9e4c-658752ef3091"
    }
  ],
