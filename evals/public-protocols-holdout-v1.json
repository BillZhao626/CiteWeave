        }
      ]
    },
    {
      "case_id": "cw-holdout-006",
      "split": "test",
      "question_type": "boundary",
      "question": "依据 RFC 2606，本地测试随意使用目前未用的 TLD，为什么可能影响以后访问真实 DNS 数据？",
      "reference_answer": "The TLD may later enter real global use, and local test versions can thwart attempts to reference the real data.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-7",
          "start_offset": 3,
          "end_offset": 64,
          "quote": "For example, without guidance, a site might set up some local"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-8",
          "start_offset": 3,
          "end_offset": 72,
          "quote": "additional unused top level domains for testing of its local DNS code"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-9",
          "start_offset": 3,
          "end_offset": 69,
          "quote": "and configuration. Later, these TLDs might come into actual use on"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-10",
          "start_offset": 3,
          "end_offset": 69,
          "quote": "the global Internet.  As a result, local attempts to reference the"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-11",
          "start_offset": 3,
          "end_offset": 63,
          "quote": "real data in these zones could be thwarted by the local test"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-12",
          "start_offset": 3,
          "end_offset": 70,
          "quote": "versions.  Or test or example code might be written that accesses a"
        }
      ]
    },
    {
      "case_id": "cw-holdout-007",
      "split": "test",
      "question_type": "direct",
      "question": "RFC 2606 的 IANA Considerations 记录 IANA 同意采取什么措施？",
      "reference_answer": "IANA agreed to the four TLD reservations and will reserve them for the indicated uses.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 2,
          "block_id": "page-2-line-5",
          "start_offset": 3,
          "end_offset": 65,
          "quote": "IANA has agreed to the four top level domain name reservations"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 2,
          "block_id": "page-2-line-6",
          "start_offset": 3,
          "end_offset": 64,
          "quote": "specified in this document and will reserve them for the uses"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 2,
          "block_id": "page-2-line-7",
          "start_offset": 3,
          "end_offset": 13,
          "quote": "indicated."
        }
      ]
    },
    {
      "case_id": "cw-holdout-008",
      "split": "test",
      "question_type": "multi_evidence",
      "question": "按 RFC 8174，关键词全大写与未大写时分别按什么含义理解？",
      "reference_answer": "Only all-capital keywords have the defined special meanings; otherwise they retain their normal English meanings and are unaffected by this document.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-24",
          "start_offset": 3,
          "end_offset": 72,
          "quote": "o  The words have the meanings specified herein only when they are in"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-25",
          "start_offset": 6,
          "end_offset": 19,
          "quote": "all capitals."
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-26",
          "start_offset": 3,
          "end_offset": 66,
          "quote": "o  When these words are not capitalized, they have their normal"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-27",
          "start_offset": 6,
          "end_offset": 61,
          "quote": "English meanings and are not affected by this document."
        }
      ]
    },
    {
      "case_id": "cw-holdout-009",
      "split": "test",
      "question_type": "boundary",
      "question": "RFC 8174 是否要求规范性文本必须包含 MUST 等关键词才算规范性内容？",
      "reference_answer": "No. Such keywords are optional; text can still be normative without using them.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-19",
          "start_offset": 3,
          "end_offset": 68,
          "quote": "o  These words can be used as defined here, but using them is not"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-20",
          "start_offset": 6,
          "end_offset": 70,
          "quote": "required.  Specifically, normative text does not require the use"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-21",
          "start_offset": 6,
          "end_offset": 68,
          "quote": "of these key words.  They are used for clarity and consistency"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-22",
          "start_offset": 6,
          "end_offset": 70,
          "quote": "when that is what's wanted, but a lot of normative text does not"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 2,
          "block_id": "page-2-line-23",
          "start_offset": 6,
          "end_offset": 38,
          "quote": "use them and is still normative."
        }
      ]
    },
    {
      "case_id": "cw-holdout-010",
      "split": "test",
      "question_type": "multi_evidence",
      "question": "RFC 8174 更新了哪个 RFC，并属于哪个 BCP？",
      "reference_answer": "It updates RFC 2119 and is part of BCP 14.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 1,
          "block_id": "page-1-line-25",
          "start_offset": 3,
          "end_offset": 67,
          "quote": "This document updates RFC 2119 by clarifying that only UPPERCASE"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 1,
          "block_id": "page-1-line-26",
          "start_offset": 3,
          "end_offset": 66,
          "quote": "usage of the key words have the defined special meanings.  This"
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 1,
          "block_id": "page-1-line-27",
          "start_offset": 3,
          "end_offset": 30,
          "quote": "document is part of BCP 14."
        }
      ]
    },
    {
      "case_id": "cw-holdout-011",
      "split": "test",
      "question_type": "multi_evidence",
      "question": "RFC 8174 是否要求 IANA 操作，它是否提出相关安全事项？",
      "reference_answer": "It requires no IANA actions and is purely procedural with no related security considerations.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 3,
          "block_id": "page-3-line-2",
          "start_offset": 3,
          "end_offset": 51,
          "quote": "This document does not require any IANA actions."
        },
        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 3,
          "block_id": "page-3-line-4",
