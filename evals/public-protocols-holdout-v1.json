    {
      "case_id": "cw-holdout-001",
      "split": "test",
      "question_type": "multi_evidence",
      "question": "RFC 2606 为测试和文档保留了哪四个顶级域名？",
      "reference_answer": "The four TLDs are .test, .example, .invalid, and .localhost.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-19",
          "start_offset": 3,
          "end_offset": 67,
          "quote": "To safely satisfy these needs, four domain names are reserved as"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-20",
          "start_offset": 3,
          "end_offset": 30,
          "quote": "listed and described below."
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-21",
          "start_offset": 19,
          "end_offset": 24,
          "quote": ".test"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-22",
          "start_offset": 16,
          "end_offset": 24,
          "quote": ".example"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-23",
          "start_offset": 16,
          "end_offset": 24,
          "quote": ".invalid"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-24",
          "start_offset": 14,
          "end_offset": 24,
          "quote": ".localhost"
        }
      ]
    },
    {
      "case_id": "cw-holdout-002",
      "split": "test",
      "question_type": "direct",
      "question": "按 RFC 2606，.test 推荐用于测试哪类代码？",
      "reference_answer": "Testing current or new DNS-related code.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-25",
          "start_offset": 6,
          "end_offset": 69,
          "quote": "\".test\" is recommended for use in testing of current or new DNS"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-26",
          "start_offset": 6,
          "end_offset": 19,
          "quote": "related code."
        }
      ]
    },
    {
      "case_id": "cw-holdout-003",
      "split": "test",
      "question_type": "multi_evidence",
      "question": "RFC 2606 中 .example 与 .invalid 的预定用途有什么区别？",
      "reference_answer": ".example is for documentation/examples; .invalid is for constructing domain names that are certainly and obviously invalid.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-27",
          "start_offset": 6,
          "end_offset": 72,
          "quote": "\".example\" is recommended for use in documentation or as examples."
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-28",
          "start_offset": 6,
          "end_offset": 69,
          "quote": "\".invalid\" is intended for use in online construction of domain"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-29",
          "start_offset": 6,
          "end_offset": 68,
          "quote": "names that are sure to be invalid and which it is obvious at a"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-30",
          "start_offset": 6,
          "end_offset": 25,
          "quote": "glance are invalid."
        }
      ]
    },
    {
      "case_id": "cw-holdout-004",
      "split": "test",
      "question_type": "multi_evidence",
      "question": "RFC 2606 描述 .localhost 传统上具有哪类 DNS 记录、指向什么地址？",
      "reference_answer": "A statically defined A record pointing to the loopback IP address.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-31",
          "start_offset": 6,
          "end_offset": 71,
          "quote": "The \".localhost\" TLD has traditionally been statically defined in"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-32",
          "start_offset": 6,
          "end_offset": 68,
          "quote": "host DNS implementations as having an A record pointing to the"
        },
        {
          "source_id": "rfc2606",
          "source_sha256": "583dcae5d3f2081574df10692f28eb2a0cfbed35f2858b88856a2053971d7274",
          "page_index": 1,
          "block_id": "page-1-line-33",
          "start_offset": 6,
          "end_offset": 71,
          "quote": "loop back IP address and is reserved for such use.  Any other use"
        }
      ]
    },
    {
      "case_id": "cw-holdout-005",
      "split": "test",
      "question_type": "localization",
      "question": "请定位 RFC 2606 第 3 节列出的三个保留示例二级域名。",
      "reference_answer": "example.com, example.net, and example.org.",
      "answerable": true,
      "gold": [
        {
          "source_id": "rfc2606",
