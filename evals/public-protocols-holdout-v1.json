        {
          "source_id": "rfc8174",
          "source_sha256": "3900e70e0670fecd80213d4d1dbb1c5eb112b2c4f87083429f991c8968f93246",
          "page_index": 3,
          "block_id": "page-3-line-5",
          "start_offset": 3,
          "end_offset": 18,
          "quote": "considerations."
        }
      ]
    },
    {
      "case_id": "cw-holdout-012",
      "split": "test",
      "question_type": "direct",
      "question": "RFC 8174 建议的声明引用哪两份 RFC，并在什么大小写条件下解释关键词？",
      "reference_answer": "BCP 14 cites RFC 2119 and RFC 8174, when and only when the keywords appear in all capitals.",
      "answerable": true,
      "gold": [
